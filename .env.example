# Copia este archivo a .env y llena los valores. Nunca subas .env al repo ni lo abras con la pantalla compartida.

# Jev (TypeSafe AI)
TYPESAFE_API_KEY=
# Opcional: otro endpoint compatible (por ejemplo OpenRouter: https://openrouter.ai/api/v1/systemone)
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-latest

# Jira Cloud (API REST): solo para escribir rápido en el backlog y para reset/siembra de respaldo.
# El token se crea en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_SITE=https://tu-sitio.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Claude: con ANTHROPIC_API_KEY las comparaciones usan la API directa (la cuenta más limpia).
# Sin ella se usa claude -p con tu sesión de Claude Code. Se fuerza con CLAUDE_ENGINE=api o CLAUDE_ENGINE=cli.
# ANTHROPIC_API_KEY=
# CLAUDE_ENGINE=
